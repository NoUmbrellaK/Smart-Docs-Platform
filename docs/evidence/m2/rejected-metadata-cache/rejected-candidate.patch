+def _verify_model(model_dir, *, tokenizer_only=False):
+    receipt = Path(model_dir) / ".smartdocs-verified.json"
+    try:
+        try:
+            receipt.lstat()
+        except FileNotFoundError:
+            return _hash_model(model_dir, tokenizer_only=tokenizer_only)
+        snapshot = _protected_model_snapshot(model_dir)
+        fd = os.open(receipt, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        with os.fdopen(fd, "rb") as source:
+            before = os.fstat(source.fileno())
+            if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0
+                    or before.st_mode & 0o022 or before.st_size > 16384):
+                raise EmbeddingError("embedding_model_unavailable")
+            body = source.read(16385)
+            after = os.fstat(source.fileno())
+        if (len(body) > 16384 or before != after
+                or json.loads(body) != {"version": 1, "hashes": MODEL_HASHES, "snapshot": snapshot}
+                or snapshot != _protected_model_snapshot(model_dir)):
+            raise EmbeddingError("embedding_model_unavailable")
+    except (OSError, ValueError, UnicodeError, RecursionError):
+        raise EmbeddingError("embedding_model_unavailable") from None
